# Database — Azure SQL (preferred) or local SQLite.
# Option A: Azure SQL — set all four vars; DATABASE_URL is built automatically.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=

# Option B: local SQLite (absolute path required)
# DATABASE_URL=sqlite:////absolute/path/to/lectora.db

# Application logs (terminal): INFO shows [EXTRACT], [TO-LLM], [A0]; WARNING shows only warnings
LOG_LEVEL=INFO

SERVICE_BUS_NAMESPACE=
SERVICE_BUS_CONNECTION_STRING=
QUEUE_NAME=course-jobs

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# A0 Scenario 2: send original PDF/DOCX to LLM (no DOCX→PDF conversion).
# Azure Files API purpose (must be "assistants" on Azure; "user_data" is not supported)
# A0_OPENAI_FILE_PURPOSE=assistants
# Optional: deployment for Responses API file input (defaults to AZURE_OPENAI_DEPLOYMENT, then A0)
# A0_TO_FILE_DEPLOYMENT=
# Max words from DOCX used only if Azure rejects DOCX file input (default 120000)
# A0_TO_SOURCE_MAX_WORDS=120000
# AZURE_OPENAI_RESPONSES_API_VERSION=2025-03-01-preview

AZURE_TENANT_ID=
# API app registration (resource) used for JWT audience validation
AZURE_API_CLIENT_ID=
AZURE_API_AUDIENCE=
AZURE_API_SCOPE=api://<AZURE_API_CLIENT_ID>/access_as_user
AZURE_AUTHORITY=https://login.microsoftonline.com/<AZURE_TENANT_ID>/v2.0
AZURE_JWKS_URL=https://login.microsoftonline.com/<AZURE_TENANT_ID>/discovery/v2.0/keys
AZURE_ISSUER=https://login.microsoftonline.com/<AZURE_TENANT_ID>/v2.0

AZURE_STORAGE_CONNECTION_STRING=
BLOB_CONTAINER_NAME=
# Container where the production pipeline uploads all job artifacts
COURSE_GENERATION_ARTIFACTS_CONTAINER_NAME=course-generation-artifacts

LANGFUSE_API_KEY=
LANGFUSE_PROJECT=
LANGFUSE_ENV=dev
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Azure AI Search (for document ingestion pipeline)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=course-chunks

# Dedicated Azure OpenAI resource for embeddings (separate from main LLM resource)
# Endpoint is derived automatically as: https://{resource_name}.openai.azure.com/
AZURE_OPENAI_EMBEDDINGS_RESOURCE_NAME=course-embeddings
AZURE_OPENAI_EMBEDDINGS_KEY=

# Embedding model deployment name on the embeddings resource
INGESTION_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Ingestion chunk sizing (tokens). Re-upload source documents after changing.
INGESTION_MAX_CHUNK_TOKENS=1500
INGESTION_MIN_CHUNK_TOKENS=80

# Section Mapper — expand vector hits to full indexed sections in enriched_sections
SECTION_MAPPER_SUBTOPIC_SEED_CHUNKS=5
SECTION_MAPPER_SUBTOPIC_SEARCH_TOP_K=24
SECTION_MAPPER_EXPAND_SECTION_CHUNKS=true
SECTION_MAPPER_MAX_SUBTOPIC_SOURCE_WORDS=12000

# Comma-separated FE origins allowed by CORS (exact matches)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8080,https://course-generation.netlify.app
# Regex for Netlify preview/production URLs (optional override)
# CORS_ORIGIN_REGEX=https://course-generation(--[a-z0-9-]+)?\.netlify\.app

